# Configuración principal de Django
SECRET_KEY=django-insecure-demo-barber-secret-key-change-in-prod-xyz789
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (por defecto SQLite si no se especifica PostgreSQL)
# Para PostgreSQL descomentar y completar:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=demo_barber_db
# DB_USER=postgres
# DB_PASSWORD=tu_password
# DB_HOST=localhost
# DB_PORT=5432

# Correo electrónico (en desarrollo se usa consola)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=contacto@demobarberclub.cl
EMAIL_HOST_PASSWORD=tu_clave_de_aplicacion
DEFAULT_FROM_EMAIL=Demo Barber Club <contacto@demobarberclub.cl>

# Configuración regional
TIME_ZONE=America/Santiago
LANGUAGE_CODE=es-cl
